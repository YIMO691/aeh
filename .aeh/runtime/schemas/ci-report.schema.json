{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH deterministic CI replay report",
  "type": "object",
  "required": ["contract", "version", "repository_id", "change_id", "base_sha", "head_sha", "observed_at", "harness", "policy_digest", "verdict", "checks", "inputs", "safety", "canonical_digest"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "ci.replay-report"},
    "version": {"type": "integer", "const": 1},
    "repository_id": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "pattern": "^CHG-[0-9]{4}-[0-9]{4}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "harness": {
      "type": "object", "required": ["version", "source_revision", "runtime_digest"], "additionalProperties": false,
      "properties": {"version": {"type": "string"}, "source_revision": {"type": "string"}, "runtime_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["PASS", "BLOCKED", "INVALID", "INCONCLUSIVE"]},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "status", "message"], "additionalProperties": false,
        "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "BLOCKED", "INVALID", "INCONCLUSIVE"]}, "message": {"type": "string"}}}
    },
    "inputs": {
      "type": "array", "items": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false,
        "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    },
    "safety": {
      "type": "object", "required": ["read_only_target", "project_code_executed", "network_used"], "additionalProperties": false,
      "properties": {"read_only_target": {"const": true}, "project_code_executed": {"const": false}, "network_used": {"const": false}}
    },
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
