{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Evidence Index Contract（Machine Truth）",
  "type": "object",
  "required": [
    "contract",
    "version",
    "change_id",
    "repository",
    "evidence"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "bootstrap.evidence-index"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4}-[0-9]{4}$"
    },
    "repository": {
      "type": "object",
      "required": [
        "root",
        "base_commit",
        "dirty"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "base_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "finding",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EV-[0-9]{3}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "SOURCE",
              "TEST",
              "CALL_PATH",
              "CONFIG",
              "ARCHITECTURE_CONSTRAINT",
              "NEGATIVE_SEARCH",
              "UNKNOWN"
            ]
          },
          "location": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              }
            }
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "DIRECT",
              "INDIRECT",
              "INFERRED"
            ]
          },
          "relevance": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "task_keyword",
                  "symbol_reference",
                  "call_relation",
                  "existing_test_relation",
                  "configuration_relation",
                  "negative_search"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          },
          "source_state": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "base_commit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dirty": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "file_hash": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "rel_path": {
                "type": "string"
              }
            }
          },
          "query": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rule": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              }
            }
          },
          "test_result": {
            "type": "string",
            "enum": [
              "FOUND",
              "NOT_FOUND",
              "NOT_VERIFIED"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
