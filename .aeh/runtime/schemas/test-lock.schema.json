{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Test Lock Record Contract",
  "type": "object",
  "required": [
    "contract",
    "version",
    "change_id",
    "files",
    "repository"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "test-lock"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4}-[0-9]{4}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "required": [
        "base_commit",
        "dirty"
      ],
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "protected": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}