{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Upgrade Policy Contract",
  "type": "object",
  "required": ["contract", "version", "managed_paths", "preserve_paths"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "bootstrap.upgrade.policy"},
    "version": {"const": 1},
    "managed_paths": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "strategy"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "strategy": {"type": "string", "enum": ["overwrite", "merge"]}
        }
      }
    },
    "preserve_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
