{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH CI replay policy",
  "type": "object",
  "required": ["contract", "version", "accepted_verification_overall", "required_change_state", "required_gates", "required_artifacts", "protected_approval_gates", "critical_merge_gate", "manual_verification_gate"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "core.ci-policy"},
    "version": {"type": "integer", "const": 1},
    "accepted_verification_overall": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["MERGE_READY", "READY_WITH_WARNINGS"]}},
    "required_change_state": {"const": "VERIFY"},
    "required_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_artifacts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.schema\\.json$"}},
    "protected_approval_gates": {"type": "array", "uniqueItems": true, "items": {"enum": ["SPEC_REVIEW", "RED_GATE", "VERIFY_MANUAL", "MERGE_GATE"]}},
    "critical_merge_gate": {"const": "MERGE_GATE"},
    "manual_verification_gate": {"const": "VERIFY_MANUAL"}
  }
}
