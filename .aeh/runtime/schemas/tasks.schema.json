{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Tasks Contract",
  "type": "object",
  "required": [
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3}$"
          },
          "name": {
            "type": "string"
          },
          "requires_req": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3}$"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TASK-[0-9]{3}$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "DONE",
              "BLOCKED"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
