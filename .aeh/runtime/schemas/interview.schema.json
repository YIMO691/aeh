{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Interview Rule Contract",
  "type": "object",
  "required": [
    "contract",
    "version",
    "scope",
    "questions"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "bootstrap.interview"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "core",
        "developer",
        "team",
        "organization",
        "ai_permissions"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "type",
          "field",
          "question",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "FACT",
              "PREFERENCE",
              "POLICY",
              "PERMISSION"
            ]
          },
          "field": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {},
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "default": {},
          "ask_when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "discovery_detected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "domain",
                    "field"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "domain": {
                      "type": "string",
                      "enum": [
                        "repository",
                        "testing",
                        "ci",
                        "git",
                        "ai_rules",
                        "architecture"
                      ]
                    },
                    "field": {
                      "type": "string"
                    },
                    "value": {}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
