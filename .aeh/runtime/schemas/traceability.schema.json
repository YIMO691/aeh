{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Traceability Contract",
  "type": "object",
  "required": [
    "requirements"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3}$"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}-[0-9]{2}$"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TEST-[0-9]{3}$"
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TASK-[0-9]{3}$"
            }
          },
          "code": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "code_id": {
                  "type": "string",
                  "pattern": "^CODE-[0-9]{3}$"
                }
              }
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^VER-[0-9]{3}$"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}