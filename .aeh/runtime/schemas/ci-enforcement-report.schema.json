{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH SCM enforcement audit report",
  "type": "object",
  "required": ["contract", "version", "provider", "repository_id", "branch", "head_sha", "required_trust_level", "achieved_trust_level", "verdict", "checks", "residual_authorities", "snapshot_digest", "canonical_digest"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "ci.enforcement-report"}, "version": {"const": 1}, "provider": {"const": "github"},
    "repository_id": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}, "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "required_trust_level": {"enum": ["OBSERVED_WORKFLOW", "REQUIRED_REPOSITORY_WORKFLOW", "EXTERNALLY_GOVERNED_WORKFLOW"]},
    "achieved_trust_level": {"enum": ["OBSERVED_WORKFLOW", "REQUIRED_REPOSITORY_WORKFLOW", "EXTERNALLY_GOVERNED_WORKFLOW"]},
    "verdict": {"enum": ["PASS", "BLOCKED", "INCONCLUSIVE"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "status", "message"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "status": {"enum": ["PASS", "BLOCKED", "INCONCLUSIVE"]}, "message": {"type": "string"}}}},
    "residual_authorities": {"type": "array", "items": {"type": "string"}},
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
