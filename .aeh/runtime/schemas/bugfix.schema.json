{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Lightweight Bugfix Contract",
  "type": "object",
  "required": [
    "problem",
    "acceptance",
    "scope"
  ],
  "properties": {
    "problem": {
      "type": "object",
      "required": [
        "observed_behavior",
        "expected_behavior"
      ],
      "additionalProperties": false,
      "properties": {
        "observed_behavior": {
          "type": "string"
        },
        "expected_behavior": {
          "type": "string"
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3}-[0-9]{2}$"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
