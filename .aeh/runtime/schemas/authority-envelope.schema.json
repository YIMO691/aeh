{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Agent Authority Envelope",
  "type": "object",
  "required": ["schema_version", "change_id", "allow"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"type": "string", "pattern": "^CHG-[0-9]{4}-[0-9]{4}$"},
    "allow": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "read_repository",
          "modify_change",
          "modify_tests",
          "modify_source",
          "run_tests",
          "commit",
          "push",
          "pull_request",
          "merge",
          "release"
        ]
      }
    }
  }
}
