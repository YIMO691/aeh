{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Test Plan Contract",
  "type": "object",
  "required": [
    "tests"
  ],
  "properties": {
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TEST-[0-9]{3}$"
          },
          "verifies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3}-[0-9]{2}$"
            }
          },
          "command": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "unit",
              "property",
              "contract",
              "integration",
              "regression",
              "runtime",
              "platform",
              "manual",
              "acceptance"
            ]
          },
          "intent": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          },
          "expected_before_fix": {
            "type": "object",
            "required": [
              "type",
              "signature"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "behavior_failure"
                ]
              },
              "signature": {
                "type": "string"
              }
            }
          },
          "fixture_signatures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "spec_mismatch_signatures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_defect_signatures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "cwd": {
                "type": "string"
              },
              "shell": {
                "type": "boolean"
              },
              "env": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "test_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "src",
          "dest"
        ],
        "additionalProperties": false,
        "properties": {
          "src": {
            "type": "string"
          },
          "dest": {
            "type": "string",
            "pattern": "^(?![A-Za-z]:[\\\\/])(?!.*(^|/)\\.\\.(/|$)).+$"
          }
        }
      }
    },
    "non_automatable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ac_id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "ac_id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3}-[0-9]{2}$"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "regression": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "command": {"type": "string"},
          "argv": {"type": "array", "items": {"type": "string"}},
          "cwd": {"type": "string"},
          "shell": {"type": "boolean"},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "timeout_seconds": {"type": "integer", "minimum": 1}
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["target_test", "regression", "integration", "contract", "runtime", "platform", "manual"]},
          "verifies": {"type": "array", "items": {"type": "string"}},
          "command": {"type": "string"},
          "argv": {"type": "array", "items": {"type": "string"}},
          "cwd": {"type": "string"},
          "shell": {"type": "boolean"},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "timeout_seconds": {"type": "integer", "minimum": 1}
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
