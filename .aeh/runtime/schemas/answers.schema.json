{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Interview Answers Contract",
  "type": "object",
  "required": [
    "contract",
    "version",
    "answers"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "bootstrap.interview.answers"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "question_id",
          "answer",
          "type",
          "source",
          "answered_at"
        ],
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "type": "string"
          },
          "answer": {},
          "type": {
            "type": "string",
            "enum": [
              "FACT",
              "PREFERENCE",
              "POLICY",
              "PERMISSION"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "user_answer",
              "repository_fact",
              "default_applied",
              "organization_policy"
            ]
          },
          "answered_at": {
            "type": "string",
            "format": "date-time"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "DETECTED",
              "INFERRED",
              "USER_CONFIRMED",
              "UNKNOWN"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "core",
              "developer",
              "team",
              "organization",
              "ai_permissions"
            ]
          }
        }
      }
    },
    "reset": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
