{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Change Lease Contract",
  "type": "object",
  "required": [
    "contract", "version", "repository_id_sha256", "change_id",
    "workspace_id_sha256", "holder_id_sha256", "fencing_token",
    "acquired_at", "expires_at", "state"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "change.lease"},
    "version": {"const": 1},
    "repository_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "change_id": {"type": "string", "pattern": "^CHG-[0-9]{4}-[0-9]{4,}$"},
    "workspace_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "holder_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_ref_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"const": "WRITE"},
    "fencing_token": {"type": "integer", "minimum": 1},
    "lease_revision": {"type": "integer", "minimum": 1},
    "acquired_at": {"type": "string", "format": "date-time"},
    "renewed_at": {
      "anyOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
    },
    "expires_at": {"type": "string", "format": "date-time"},
    "released_at": {"type": "string", "format": "date-time"},
    "recovered_at": {"type": "string", "format": "date-time"},
    "change_truth_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "active_operation": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["operation", "operation_id_sha256", "pre_truth_sha256", "begun_at"],
          "additionalProperties": false,
          "properties": {
            "operation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
            "operation_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "pre_truth_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "begun_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "state": {"enum": ["ACTIVE", "RELEASED", "EXPIRED", "RECOVERED"]}
  }
}
