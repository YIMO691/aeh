{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Human Approval Contract",
  "type": "object",
  "required": [
    "approvals"
  ],
  "properties": {
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "status",
          "actor",
          "decided_at"
        ],
        "additionalProperties": false,
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "SPEC_REVIEW",
              "RED_GATE",
              "MERGE_GATE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED",
              "PENDING"
            ]
          },
          "actor": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "human",
                  "system"
                ]
              },
              "id": {
                "type": "string"
              }
            }
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ref": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "APPROVED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "actor": {
                  "properties": {
                    "type": {
                      "const": "human"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              },
              "required": [
                "actor"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}