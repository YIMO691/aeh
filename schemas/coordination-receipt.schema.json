{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Coordination Receipt Contract",
  "type": "object",
  "required": [
    "contract", "version", "operation", "outcome",
    "repository_id_sha256", "workspace_id_sha256", "change_id",
    "change_truth_sha256", "store_revision", "observed_at", "digest"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "coordination.receipt"},
    "version": {"const": 1},
    "operation": {"enum": ["STATUS", "ACQUIRE", "RENEW", "RELEASE", "RECOVER", "RESERVE"]},
    "outcome": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "repository_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "change_id": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^CHG-[0-9]{4}-[0-9]{4,}$"}
      ]
    },
    "change_truth_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "store_revision": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
