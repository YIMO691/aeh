{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH normalized GitHub event binding",
  "type": "object",
  "required": ["contract", "version", "provider", "event_type", "repository", "base_sha", "head_sha", "pull_request_number"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "ci.provider-event"}, "version": {"const": 1}, "provider": {"const": "github"},
    "event_type": {"enum": ["pull_request", "merge_group"]},
    "repository": {"type": "object", "required": ["id", "full_name"], "additionalProperties": false,
      "properties": {"id": {"type": "integer", "minimum": 1}, "full_name": {"type": "string", "pattern": "^[^/]+/[^/]+$"}}},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pull_request_number": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}
  }
}
