{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Green / Refactor Evidence Contract",
  "type": "object",
  "required": [
    "contract",
    "version",
    "change_id",
    "base_commit",
    "test_lock_hash",
    "production_before_hash",
    "production_after_hash",
    "tests",
    "changed_files",
    "verdict"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "green.evidence"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{4}-[0-9]{4}$"
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "test_lock_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "production_before_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "production_after_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "exit_code",
          "output_ref",
          "output_hash",
          "verdict"
        ],
        "additionalProperties": false,
        "properties": {
          "test_id": {
            "type": "string",
            "pattern": "^TEST-[0-9]{3}$"
          },
          "command": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": "integer"
          },
          "output_ref": {
            "type": "string"
          },
          "output_hash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "verdict": {
            "type": "string",
            "const": "PASS"
          }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code_id",
          "path",
          "before_hash",
          "after_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "code_id": {
            "type": "string",
            "pattern": "^CODE-[0-9]{3}$"
          },
          "path": {
            "type": "string"
          },
          "before_hash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "after_hash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "GREEN_PASS",
        "REFACTOR_PASS"
      ]
    }
  },
  "additionalProperties": false
}
