{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Adapter Render Output Contract",
  "type": "object",
  "required": [
    "adapter",
    "status",
    "managed_section",
    "permission_mapping",
    "semantics",
    "diagnostics"
  ],
  "properties": {
    "adapter": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "status": {
      "type": "string",
      "const": "RENDERED"
    },
    "managed_section": {
      "type": "string",
      "minLength": 1
    },
    "permission_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "value",
          "channel",
          "status",
          "expression"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "value": {},
          "channel": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ENFORCEABLE",
              "GUIDANCE_ONLY",
              "UNENFORCEABLE"
            ]
          },
          "expression": {}
        }
      }
    },
    "semantics": {
      "type": "object"
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "unsupported_capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "unsupported_capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "required_semantic",
              "adapter",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "required_semantic": {
                "type": "string"
              },
              "adapter": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "UNENFORCEABLE",
                  "GUIDANCE_ONLY"
                ]
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
