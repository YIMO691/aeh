{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Discovery Rule Contract",
  "type": "object",
  "required": [
    "contract",
    "version",
    "domain",
    "detectors"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "bootstrap.discovery.rule"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "repository",
        "testing",
        "ci",
        "git",
        "ai_rules",
        "architecture"
      ]
    },
    "unknown_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "multi_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "field",
          "value",
          "markers"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "field": {
            "type": "string"
          },
          "value": {},
          "confidence": {
            "type": "string",
            "enum": [
              "DETECTED",
              "INFERRED",
              "USER_CONFIRMED",
              "UNKNOWN"
            ]
          },
          "match": {
            "type": "string",
            "enum": [
              "any",
              "all"
            ]
          },
          "markers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "file",
                    "dir",
                    "glob",
                    "content"
                  ]
                },
                "path": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^(?![A-Za-z]:[\\\\/])(?!.*(^|/)\\.\\.(/|$)).+$"
                },
                "pattern": {
                  "type": "string",
                  "maxLength": 256
                },
                "contains": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": [
                          "file",
                          "dir",
                          "content"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "glob"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "pattern"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "content"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "contains"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}