{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Upgrade Plan Contract",
  "type": "object",
  "required": ["contract", "version", "target", "dry_run", "source", "destination", "preserve_paths", "operations"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "upgrade.plan"},
    "version": {"const": 1},
    "target": {"type": "string"},
    "dry_run": {"type": "boolean"},
    "source": {"$ref": "#/definitions/endpoint"},
    "destination": {"$ref": "#/definitions/endpoint"},
    "preserve_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "path", "policy", "reason", "before_hash", "after_hash", "source_ref"],
        "additionalProperties": false,
        "properties": {
          "action": {"type": "string", "enum": ["INSTALL_RUNTIME", "REPLACE_RUNTIME", "REMOVE_RUNTIME", "MERGE_MANIFEST"]},
          "path": {"type": "string", "pattern": "^(?![A-Za-z]:[\\/])(?!.*(^|/)\\.\\.(/|$)).+$"},
          "policy": {"type": "string", "enum": ["overwrite", "remove", "merge"]},
          "reason": {"type": "string", "minLength": 1},
          "before_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "after_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "source_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "definitions": {
    "endpoint": {
      "type": "object",
      "required": ["harness_version", "source_revision", "runtime_digest"],
      "additionalProperties": false,
      "properties": {
        "harness_version": {"type": "string"},
        "source_revision": {"type": "string"},
        "runtime_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
