{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Spec Contract",
  "type": "object",
  "required": [
    "requirements"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "behavior",
          "acceptance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3}$"
          },
          "behavior": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "CURRENT",
              "DESIRED",
              "CONSTRAINT"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "EVIDENCE_DERIVED",
                  "USER_REQUIREMENT",
                  "POLICY_CONSTRAINT"
                ]
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure_behavior": {
            "type": "string"
          },
          "supported_by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EV-[0-9]{3}$"
            }
          },
          "scope_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "statement"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-[0-9]{3}-[0-9]{2}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "automated",
                    "manual",
                    "invariant"
                  ]
                },
                "statement": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
