{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEH Manifest Contract",
  "type": "object",
  "required": [
    "harness",
    "compiler",
    "schema",
    "installed_at",
    "source_hashes"
  ],
  "properties": {
    "harness": {
      "type": "object",
      "required": [
        "name",
        "version",
        "source_revision"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "compiler": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "schema": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "installed_at": {
      "type": "string",
      "format": "date-time"
    },
    "recompiled_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_hashes": {
      "type": "object",
      "required": [
        "runtime",
        "compiler",
        "bootstrap_contract",
        "adapters"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "compiler": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "bootstrap_contract": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "adapters": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    }
  },
  "additionalProperties": true
}
